    {
      "name": "Auth - Register Nasabah",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const random = Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('random_email', 'tester' + random + '@example.com');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Token returned and saved', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('token');",
              "    pm.expect(jsonData.data.user.role).to.eql('nasabah');",
              "    pm.collectionVariables.set('auth_token', jsonData.data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Testing Nasabah\",\n  \"email\": \"{{random_email}}\",\n  \"password\": \"password123\",\n  \"phone\": \"081234567890\",\n  \"address\": \"Jl. Pengujian No. 1\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
